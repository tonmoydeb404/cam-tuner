{
  "name": "cam-tuner",
  "version": "3.1.2",
  "private": false,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @cam-tuner/web dev",
    "dev:ext": "pnpm --filter @cam-tuner/extension dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "sync-brand": "node scripts/sync-brand.mjs",
    "sync-brand:check": "node scripts/sync-brand.mjs --check",
    "release:tag": "node ./scripts/release-tag-sync.mjs",
    "prepare": "git config core.hooksPath .husky || true"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.8",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  }
}
